{
  "name": "flash-sale-system",
  "private": true,
  "version": "1.0.0",
  "description": "High-throughput flash sale system — npm-workspaces monorepo",
  "workspaces": [
    "api",
    "web"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c blue,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "npm run dev --workspace=@flash-sale/api",
    "dev:web": "npm run dev --workspace=@flash-sale/web",
    "build": "npm run build --workspaces --if-present",
    "build:api": "npm run build --workspace=@flash-sale/api",
    "build:web": "npm run build --workspace=@flash-sale/web",
    "start:api": "npm run start --workspace=@flash-sale/api",
    "test": "npm run test --workspace=@flash-sale/api",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "stress": "npm run stress --workspace=@flash-sale/api",
    "clean": "rm -rf node_modules api/node_modules web/node_modules api/dist web/dist"
  },
  "devDependencies": {
    "@types/node": "^22.20.2",
    "concurrently": "^9.0.1"
  },
  "engines": {
    "node": ">=20"
  }
}
