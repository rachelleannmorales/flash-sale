# --- Runtime ---
NODE_ENV=development           # development | test | production
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info

# --- Storage ---
# Required in production (no localhost default). Compose host port is 5433.
DATABASE_URL=postgres://flash:flash@127.0.0.1:5432/flashsale
DATABASE_POOL_MAX=20
# Shared rate-limit counter. Required in production. Compose host port is 6380.
REDIS_URL=redis://127.0.0.1:6379

# --- Sale definition ---
SALE_ID=flash-2026
TOTAL_STOCK=1000
# ISO strings or ms epoch. REQUIRED in production (fail-fast).
SALE_START=2026-09-10T13:00:00Z
SALE_END=2026-09-10T14:00:00Z

# --- Abuse guard (not correctness) ---
RATE_LIMIT_MAX=60
RATE_LIMIT_WINDOW=10 seconds
